FROM registry.access.redhat.com/ubi9/python-312

WORKDIR /opt/app-root/src

# Copy dependency files first for layer caching
COPY requirements.txt ./

# Install core dependencies + FastAPI/uvicorn for the PoC wrapper
RUN pip install --no-cache-dir \
    -r requirements.txt \
    fastapi \
    uvicorn[standard]

# Copy all application source and metadata files
COPY src/ ./src/
COPY poc_api.py ./
COPY scripts/ ./scripts/
COPY pyproject.toml README.md LICENSE NOTICE ./

# Use PYTHONPATH instead of pip install since package requires Python 3.13+
ENV PYTHONPATH="/opt/app-root/src/src:${PYTHONPATH}"

# OpenShift compatibility - must run as root for chgrp
USER 0
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root
USER 1001

EXPOSE 8080

CMD ["uvicorn", "poc_api:app", "--host", "0.0.0.0", "--port", "8080"]
